{
  "framework": "vite",
  "buildCommand": "vite build",
  "rewrites": [
    { "source": "/moeglichkeitensystem", "destination": "/" },
    { "source": "/moeglichkeitensystem/", "destination": "/" },
    { "source": "/moeglichkeitensystem/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://peddavommond.de https://www.peddavommond.de"
        }
      ]
    }
  ]
}
